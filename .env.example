# Supabase — plataforma (tenants SHARED)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Servidor únicamente. Bypassea RLS: nunca en código de cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Autoriza /api/internal/webhooks/dispatch (cron de GitHub Actions).
# Debe valer lo mismo que el secreto CRON_SECRET del repo y que la variable
# del servicio en Railway, o el worker responde 401 y la cola no se drena.
CRON_SECRET=

# URL pública del CMS (enlaces en emails de invitación)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Almacenamiento (opcional) -------------------------------------
# Por defecto todo va a Supabase Storage. Estas variables sólo hacen falta
# cuando un tenant tiene `storage_provider = 'S3'` o `'R2'`.
#
# El proveedor se decide POR ARCHIVO (`media.provider`), así que activarlo en
# un cliente no rompe lo que ya subió: lo antiguo se sigue sirviendo desde
# Supabase mientras lo nuevo va al bucket externo.

# S3_ENDPOINT=                 # opcional en AWS; obligatorio en gateways compatibles
# S3_REGION=eu-west-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=          # base del CDN, si el bucket sirve contenido público

# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BASE_URL=
